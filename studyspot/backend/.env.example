# Copy this file to ".env" and change the values for your computer.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studyspot_db

# --- Server ---
PORT=5000
# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text
# Address of the website (used in password-reset links)
APP_URL=http://localhost:5173

# --- Demo mode ---
# true  = the "forgot password" page shows the reset link on screen (no email server needed).
# false = the link is only printed in the server console (use this when an email service is added).
SHOW_RESET_LINK=true
